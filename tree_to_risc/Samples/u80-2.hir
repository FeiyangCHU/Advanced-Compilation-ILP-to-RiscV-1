/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_1 "0"
label L_str_0 "FUNCTION"

/* Function Definitions */
/* function : test__int */
# Routine: L1
label L1
  # Body
  move
  temp rv
  binop
  add  
  temp i0  
  const 1  label end
  
  /* function : test__string */
    # Routine: L2
  label L2
    # Body
    move
    temp rv
    call
      name concat
      temp i0      
      call
        name string_of_int
        const 1        
      call end      
    call end    label end
    
    
    /* Main */
    # Routine main
    label main
    sxp
      eseq
        sxp
          call
            name print
            call
              name concat
              call
                name concat
                name L_str_0                
                call
                  name string_of_int
                  call
                    name L1
                    const 2                    
                  call end                  
                call end                
              call end              
              call
                name L2
                name L_str_1                
              call end              
            call end            
          call end
        const 0    
label end
