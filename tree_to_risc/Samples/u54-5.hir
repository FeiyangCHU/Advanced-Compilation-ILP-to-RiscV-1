/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_0 "cou"

/* Function Definitions */
/* function : deuxfois__int */
# Routine: L1
label L1
  # Body
  move
  temp rv
  binop
  add  
  temp i0  
  temp i0  label end
  
  /* function : deuxfois__string */
    # Routine: L2
  label L2
    # Body
    move
    temp rv
    call
      name concat
      temp i0      
      temp i0      
    call end    label end
    
    
    /* Main */
    # Routine main
    label main
    sxp
      eseq 
        sxp
          eseq
            sxp
              call
                name print
                call
                  name L2
                  name L_str_0                  
                call end                
              call end
            const 0          
        eseq
          sxp
            call
              name print
              call
                name string_of_int
                call
                  name L1
                  const 2                  
                call end                
              call end              
            call end
          const 0    
label end
