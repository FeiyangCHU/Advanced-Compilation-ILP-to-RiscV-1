/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
    seq
      cjump
        ne
        const 1        
        const 0
        name L1
        name L2
      label L1
      move
      temp t1
      const 1      
      jump name L3
      label L2
      move
      temp t1
      const 2      
      label L3
    seq end
    temp t1
label end
