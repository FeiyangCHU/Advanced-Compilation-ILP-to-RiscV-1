/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_0 "invisible"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq 
    sxp
      eseq
        seq
          cjump
            ne
            const 1            
            const 0
            name L1
            name L2
          label L1
          move
          temp t1
          eseq
            sxp
              call
                name print
                name L_str_0                
              call end
            const 0          
          jump name L3
          label L2
          move
          temp t1
          const 0          
          label L3
        seq end
        temp t1      
    const 48
label end
