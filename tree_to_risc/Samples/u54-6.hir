  eseq
  seq
  move
    temp t1
    binop
    add    
    temp i0    
    const 1  
  seq end
  binop
  mul  
  const 2  
  temp t1  label end
  
  
  /* Main */
  # Routine main
  label main
  sxp
    eseq
      sxp
