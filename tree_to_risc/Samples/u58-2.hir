/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_0 "hello"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
  seq
  move
    temp t1
    const 1  
  seq end
  eseq 
    sxp
      eseq
        move
          temp t2
          name L_str_0          
        temp t2      
    temp t2
label end
