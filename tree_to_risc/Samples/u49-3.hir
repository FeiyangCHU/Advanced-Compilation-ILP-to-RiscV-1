/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_0 "*"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  call
    name concat
    call
      name string_of_float
      float       binop
      divF      
      constF 5.0      
      callF
        name float_of_int
        const 2        
      call end      
    call end    
    name L_str_0    
  call end
label end
