/* == High Level Intermediate representation. == */
/* String Litterals */
label L_str_1 "false"
label L_str_0 "true"

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
    sxp
      call
        name print
        eseq
          seq
            cjump
              ne
              eseq 
                seq 
                  sxp
                    name L_str_0                    
                  sxp
                    const 1                    
                seq end
                const 1              
              const 0
              name L1
              name L2
            label L1
            move
            temp t1
            name L_str_0            
            jump name L3
            label L2
            move
            temp t1
            name L_str_1            
            label L3
          seq end
          temp t1        
      call end
    const 0
label end
