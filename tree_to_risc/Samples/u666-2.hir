/* == High Level Intermediate representation. == */
/* String Litterals */

/* Function Definitions */
/* function : fact__int */
# Routine: L1
label L1
  # Body
  move
  temp rv
  eseq
    seq
      cjump
        ne
        eseq
          seq
            cjump
              eq
              temp i0              
              const 0              
              name L5
              name L6
            label L5
            move
            temp t2
            const 1
            jump name L7
            label L6
            move
            temp t2
            const 0
            label L7
          seq end
          temp t2
        
        const 0
        name L2
        name L3
      label L2
      move
      temp t1
      const 1      
      jump name L4
      label L3
      move
      temp t1
      binop
      mul      
      temp i0      
      call
        name L1
        binop
        sub        
        temp i0        
        const 1        
      call end      
      label L4
    seq end
    temp t1  label end
  
  
  /* Main */
  # Routine main
  label main
  sxp
    call
      name L1
      const 5      
    call end  
label end
