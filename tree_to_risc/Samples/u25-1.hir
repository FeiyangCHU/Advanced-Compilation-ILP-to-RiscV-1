/* String Litterals */

/* Function Definitions */

/* Main */
# Routine main
label main
sxp
  eseq
    seq
      cjump
        ne
        const 1        
        const 0
        name L1
        name L2
      label L1
      move
      temp f1
      constF 1.5      
      jump name L3
      label L2
      move
      temp f1
      constF 0.      
      label L3
    seq end
    temp f1
label end
